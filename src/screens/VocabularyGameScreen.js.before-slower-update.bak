import React, { useCallback, useEffect, useRef, useState } from 'react';
import {
  Animated,
  Keyboard,
  Platform,
  SafeAreaView,
  StyleSheet,
  Text,
  TextInput,
  TouchableOpacity,
  View,
} from 'react-native';

const WORDS = [
  { word: 'curious', hint: 'Eager to know or learn something' },
  { word: 'brave', hint: 'Ready to face danger or difficulty without fear' },
  { word: 'ancient', hint: 'Very old; belonging to the distant past' },
  { word: 'rapid', hint: 'Happening or moving very quickly' },
  { word: 'generous', hint: 'Willing to give or share more than expected' },
  { word: 'whisper', hint: 'To speak very softly' },
  { word: 'journey', hint: 'The act of travelling from one place to another' },
  { word: 'accurate', hint: 'Correct and free from mistakes' },
  { word: 'confident', hint: 'Feeling sure about your ability or yourself' },
  { word: 'discover', hint: 'To find something for the first time' },
  { word: 'fragile', hint: 'Easily broken or damaged' },
  { word: 'improve', hint: 'To make or become better' },
  { word: 'patient', hint: 'Able to wait calmly without getting annoyed' },
  { word: 'essential', hint: 'Absolutely necessary or very important' },
  { word: 'persuade', hint: 'To convince someone to do or believe something' },
  { word: 'observe', hint: 'To watch carefully or notice something' },
  { word: 'enormous', hint: 'Extremely large in size or amount' },
  { word: 'achieve', hint: 'To successfully reach a goal' },
  { word: 'polite', hint: 'Showing good manners and respect' },
  { word: 'mysterious', hint: 'Difficult to explain, understand, or identify' },
];

const ROUND_MS = 10500;
const MIN_ROUND_MS = 3600;
const SPEED_STEP_MS = 350;

export default function VocabularyGameScreen({ onBack }) {
  const [roundIndex, setRoundIndex] = useState(0);
  const [score, setScore] = useState(0);
  const [streak, setStreak] = useState(0);
  const [bestStreak, setBestStreak] = useState(0);
  const [lives, setLives] = useState(3);
  const [answer, setAnswer] = useState('');
  const [feedback, setFeedback] = useState('Type the word that matches the meaning.');
  const [feedbackKind, setFeedbackKind] = useState('neutral');
  const [gameOver, setGameOver] = useState(false);
  const [laneHeight, setLaneHeight] = useState(390);
  const fallY = useRef(new Animated.Value(-90)).current;
  const animationRef = useRef(null);
  const roundLockRef = useRef(false);
  const inputRef = useRef(null);
  const advanceRoundRef = useRef(null);

  const word = WORDS[roundIndex % WORDS.length];
  const roundDuration = Math.max(MIN_ROUND_MS, ROUND_MS - roundIndex * SPEED_STEP_MS);
  const level = Math.floor(roundIndex / 4) + 1;

  const advanceRound = useCallback((wasCorrect, timedOut = false) => {
    if (roundLockRef.current || gameOver) return;
    roundLockRef.current = true;
    animationRef.current?.stop();
    Keyboard.dismiss();
    setAnswer('');

    if (wasCorrect) {
      setScore((current) => current + 10 + Math.min(streak, 10));
      setStreak((current) => {
        const next = current + 1;
        setBestStreak((best) => Math.max(best, next));
        return next;
      });
      setFeedback(`Correct! “${word.word}” — ${word.hint.toLowerCase()}.`);
      setFeedbackKind('success');
    } else {
      setStreak(0);
      setLives((current) => Math.max(0, current - 1));
      if (lives <= 1) setGameOver(true);
      setFeedback(timedOut ? `Too slow! The word was “${word.word}”.` : `Not quite — the word was “${word.word}”.`);
      setFeedbackKind('error');
    }

    setTimeout(() => {
      if (!gameOver && lives > (wasCorrect ? 0 : 1)) {
        setRoundIndex((current) => current + 1);
      }
      roundLockRef.current = false;
    }, 650);
  }, [gameOver, lives, streak, word, animationRef]);

  advanceRoundRef.current = advanceRound;

  useEffect(() => {
    if (gameOver) {
      animationRef.current?.stop();
      return undefined;
    }
    roundLockRef.current = false;
    fallY.setValue(-90);
    animationRef.current = Animated.timing(fallY, {
      toValue: Math.max(230, laneHeight - 112),
      duration: roundDuration,
      useNativeDriver: true,
    });
    animationRef.current.start(({ finished }) => {
      if (finished) advanceRoundRef.current?.(false, true);
    });
    return () => animationRef.current?.stop();
  }, [roundIndex, gameOver, laneHeight, fallY, roundDuration]);

  const submitAnswer = () => {
    if (gameOver || roundLockRef.current || !answer.trim()) return;
    if (answer.trim().toLocaleLowerCase() === word.word.toLocaleLowerCase()) {
      advanceRound(true, false);
    } else {
      setFeedback('Not yet — keep trying before it reaches the bottom!');
      setFeedbackKind('neutral');
    }
  };

  const restartGame = () => {
    animationRef.current?.stop();
    roundLockRef.current = false;
    setRoundIndex(0);
    setScore(0);
    setStreak(0);
    setBestStreak(0);
    setLives(3);
    setAnswer('');
    setFeedback('Type the word that matches the meaning.');
    setFeedbackKind('neutral');
    setGameOver(false);
  };

  return (
    <SafeAreaView style={styles.safeArea}>
      <View style={styles.page}>
        <View style={styles.header}>
          <TouchableOpacity onPress={onBack} style={styles.backButton} activeOpacity={0.8}>
            <Text style={styles.backText}>‹  Back</Text>
          </TouchableOpacity>
          <View style={styles.headingBlock}>
            <Text style={styles.eyebrow}>VOCABULARY ARCADE</Text>
            <Text style={styles.title}>Word Fall</Text>
          </View>
          <View style={styles.levelPill}><Text style={styles.levelText}>LV {level}</Text></View>
        </View>

        <View style={styles.statsRow}>
          <View style={styles.statCard}><Text style={styles.statLabel}>SCORE</Text><Text style={styles.statValue}>{score}</Text></View>
          <View style={styles.statCard}><Text style={styles.statLabel}>STREAK</Text><Text style={styles.statValue}>{streak} <Text style={styles.statSmall}>🔥</Text></Text></View>
          <View style={styles.statCard}><Text style={styles.statLabel}>LIVES</Text><Text style={styles.statValue}>{'♥ '.repeat(lives).trim() || '—'}</Text></View>
        </View>

        <View style={styles.instructionRow}>
          <Text style={styles.instructionIcon}>✦</Text>
          <Text style={styles.instruction}>Read the meaning. Type the matching vocabulary word before it falls.</Text>
        </View>

        <View style={styles.gameLane} onLayout={(event) => setLaneHeight(event.nativeEvent.layout.height)}>
          <View style={styles.laneTopLabel}><Text style={styles.laneLabelText}>WORD INCOMING</Text><View style={styles.liveDot} /></View>
          <View style={styles.laneTrack} />
          {!gameOver && (
            <Animated.View style={[styles.fallingCard, { transform: [{ translateY: fallY }] }]}>
              <View style={styles.cardGlow} />
              <Text style={styles.hintLabel}>MEANING / HINT</Text>
              <Text style={styles.hintText}>{word.hint}</Text>
              <View style={styles.cardFooter}><Text style={styles.cardFooterText}>TYPE THE WORD</Text><Text style={styles.cardArrow}>↓</Text></View>
            </Animated.View>
          )}
          <View style={styles.dangerLine}><Text style={styles.dangerText}>DON’T LET IT DROP</Text></View>
          {gameOver && (
            <View style={styles.gameOverOverlay}>
              <Text style={styles.gameOverEmoji}>🏁</Text>
              <Text style={styles.gameOverTitle}>Game Over</Text>
              <Text style={styles.gameOverCopy}>Final score: {score} · Best streak: {bestStreak}</Text>
              <TouchableOpacity style={styles.restartButton} onPress={restartGame} activeOpacity={0.85}><Text style={styles.restartText}>Play again ↻</Text></TouchableOpacity>
            </View>
          )}
        </View>

        <View style={styles.answerPanel}>
          <Text style={styles.answerLabel}>YOUR ANSWER</Text>
          <View style={styles.inputRow}>
            <TextInput
              ref={inputRef}
              value={answer}
              onChangeText={setAnswer}
              onSubmitEditing={submitAnswer}
              placeholder="Type the vocabulary word…"
              placeholderTextColor="#718096"
              autoCapitalize="none"
              autoCorrect={false}
              returnKeyType="send"
              editable={!gameOver}
              style={styles.answerInput}
              accessibilityLabel="Type the vocabulary word"
            />
            <TouchableOpacity style={[styles.submitButton, (gameOver || !answer.trim()) && styles.submitDisabled]} onPress={submitAnswer} disabled={gameOver || !answer.trim()} activeOpacity={0.85}>
              <Text style={styles.submitText}>GO ↗</Text>
            </TouchableOpacity>
          </View>
          <Text style={[styles.feedback, feedbackKind === 'success' && styles.feedbackSuccess, feedbackKind === 'error' && styles.feedbackError]}>{feedback}</Text>
          <View style={styles.progressTrack}><View style={[styles.progressFill, { width: `${Math.min(100, ((roundIndex % WORDS.length) + 1) / WORDS.length * 100)}%` }]} /></View>
          <View style={styles.bottomMeta}><Text style={styles.metaText}>ROUND {roundIndex + 1}</Text><Text style={styles.metaText}>SPEED INCREASES EACH ROUND</Text></View>
        </View>
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  safeArea: { flex: 1, backgroundColor: '#070D10' },
  page: { flex: 1, paddingHorizontal: 16, paddingTop: Platform.OS === 'web' ? 12 : 6, paddingBottom: 12, backgroundColor: '#070D10' },
  header: { flexDirection: 'row', alignItems: 'center', minHeight: 58, marginBottom: 12 },
  backButton: { paddingVertical: 9, paddingRight: 8, minWidth: 64 },
  backText: { color: '#A7B5C7', fontSize: 14, fontWeight: '600' },
  headingBlock: { flex: 1, alignItems: 'center' },
  eyebrow: { color: '#7187FF', fontSize: 9, fontWeight: '800', letterSpacing: 2 },
  title: { color: '#F4F7FF', fontSize: 23, fontWeight: '800', marginTop: 1, letterSpacing: -0.5 },
  levelPill: { backgroundColor: '#1A2340', borderColor: '#344477', borderWidth: 1, paddingHorizontal: 10, paddingVertical: 7, borderRadius: 12, minWidth: 54, alignItems: 'center' },
  levelText: { color: '#AAB8FF', fontSize: 11, fontWeight: '800' },
  statsRow: { flexDirection: 'row', gap: 9, marginBottom: 12 },
  statCard: { flex: 1, backgroundColor: '#111A24', borderColor: '#202D3C', borderWidth: 1, borderRadius: 14, paddingHorizontal: 12, paddingVertical: 10 },
  statLabel: { color: '#77879B', fontSize: 9, fontWeight: '800', letterSpacing: 1.4 },
  statValue: { color: '#F1F5FF', fontSize: 19, fontWeight: '800', marginTop: 3 },
  statSmall: { fontSize: 13 },
  instructionRow: { flexDirection: 'row', alignItems: 'center', gap: 9, paddingHorizontal: 12, paddingVertical: 10, borderRadius: 12, backgroundColor: '#111827', borderWidth: 1, borderColor: '#222E46', marginBottom: 11 },
  instructionIcon: { color: '#AAB8FF', fontSize: 17, fontWeight: '800' },
  instruction: { flex: 1, color: '#B6C2D2', fontSize: 12, lineHeight: 17 },
  gameLane: { flex: 1, minHeight: 250, maxHeight: 490, borderRadius: 20, overflow: 'hidden', backgroundColor: '#0C141E', borderWidth: 1, borderColor: '#24334A', position: 'relative' },
  laneTopLabel: { position: 'absolute', zIndex: 2, top: 13, left: 14, right: 14, flexDirection: 'row', alignItems: 'center', gap: 7 },
  laneLabelText: { color: '#62758E', fontSize: 9, letterSpacing: 1.7, fontWeight: '800' },
  liveDot: { width: 6, height: 6, borderRadius: 3, backgroundColor: '#61E3B2' },
  laneTrack: { position: 'absolute', top: 42, bottom: 30, left: '50%', width: 1, backgroundColor: '#172536' },
  fallingCard: { position: 'absolute', top: 54, left: 18, right: 18, minHeight: 146, borderRadius: 18, padding: 17, backgroundColor: '#18243A', borderWidth: 1, borderColor: '#5B70D6', justifyContent: 'center', shadowColor: '#536BFF', shadowOpacity: 0.25, shadowRadius: 18, elevation: 6 },
  cardGlow: { position: 'absolute', top: 0, left: 20, right: 20, height: 2, backgroundColor: '#9CA9FF', borderRadius: 2 },
  hintLabel: { color: '#91A2FF', fontSize: 9, fontWeight: '800', letterSpacing: 1.8, marginBottom: 9 },
  hintText: { color: '#F4F6FF', fontSize: 17, lineHeight: 24, fontWeight: '700' },
  cardFooter: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginTop: 13, paddingTop: 10, borderTopWidth: 1, borderTopColor: '#34415A' },
  cardFooterText: { color: '#8B9AB3', fontSize: 9, letterSpacing: 1.5, fontWeight: '800' },
  cardArrow: { color: '#9EACFF', fontSize: 16, fontWeight: '800' },
  dangerLine: { position: 'absolute', bottom: 0, left: 0, right: 0, height: 28, alignItems: 'center', justifyContent: 'center', borderTopWidth: 1, borderTopColor: '#633D48', backgroundColor: 'rgba(95, 37, 53, 0.18)' },
  dangerText: { color: '#C37E8B', fontSize: 9, fontWeight: '800', letterSpacing: 2 },
  gameOverOverlay: { ...StyleSheet.absoluteFillObject, zIndex: 5, backgroundColor: 'rgba(7, 13, 16, 0.94)', alignItems: 'center', justifyContent: 'center', padding: 20 },
  gameOverEmoji: { fontSize: 36, marginBottom: 8 },
  gameOverTitle: { color: '#F4F7FF', fontSize: 26, fontWeight: '800' },
  gameOverCopy: { color: '#9CAAC0', fontSize: 13, marginTop: 8, marginBottom: 18, textAlign: 'center' },
  restartButton: { backgroundColor: '#6578FF', paddingHorizontal: 22, paddingVertical: 12, borderRadius: 12 },
  restartText: { color: '#FFFFFF', fontWeight: '800', fontSize: 14 },
  answerPanel: { paddingTop: 12 },
  answerLabel: { color: '#7F8EA3', fontSize: 9, fontWeight: '800', letterSpacing: 1.8, marginBottom: 7 },
  inputRow: { flexDirection: 'row', gap: 8 },
  answerInput: { flex: 1, minWidth: 0, backgroundColor: '#111A24', borderWidth: 1, borderColor: '#29384A', borderRadius: 13, color: '#F4F7FF', paddingHorizontal: 14, paddingVertical: Platform.OS === 'ios' ? 13 : 10, fontSize: 14 },
  submitButton: { minWidth: 68, borderRadius: 13, backgroundColor: '#6578FF', alignItems: 'center', justifyContent: 'center', paddingHorizontal: 13 },
  submitDisabled: { opacity: 0.45 },
  submitText: { color: '#FFFFFF', fontWeight: '900', fontSize: 12, letterSpacing: 0.5 },
  feedback: { color: '#91A1B5', fontSize: 11, minHeight: 28, paddingTop: 7, lineHeight: 16 },
  feedbackSuccess: { color: '#6DE0B0' },
  feedbackError: { color: '#FF8994' },
  progressTrack: { height: 4, borderRadius: 2, backgroundColor: '#1A2736', overflow: 'hidden', marginTop: 3 },
  progressFill: { height: 4, borderRadius: 2, backgroundColor: '#6578FF' },
  bottomMeta: { flexDirection: 'row', justifyContent: 'space-between', marginTop: 8 },
  metaText: { color: '#596B80', fontSize: 8, letterSpacing: 1.1, fontWeight: '800' },
});
